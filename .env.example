# LLM provider
MODEL_NAME=gemini/gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=openai/gpt-4o-mini

# External tools
SERPER_API_KEY=your_serper_api_key_here

# API service
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
MAX_UPLOAD_BYTES=52428800
MAX_EXTRACT_CHARS=150000

# Database
# Relative sqlite paths are normalized to project root by the app.
DATABASE_URL=sqlite:///financial_analyzer.db

# Queue worker
REDIS_URL=redis://localhost:6379/0
# Set to true in development (no Redis) so /analyze/async falls back to background tasks.
# Keep false in production to ensure proper queueing.
ALLOW_INPROCESS_FALLBACK=true
CELERY_STATUS_CACHE_TTL_SECONDS=10
THREAD_POOL_WORKERS=4

# Comma-separated admin keys used for privileged endpoints
ADMIN_API_KEYS=
